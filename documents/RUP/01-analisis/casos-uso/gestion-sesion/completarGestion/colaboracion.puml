@startuml completarGestion-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "completarGestion()" {
    rectangle #629EF9 CompletarGestionView
    rectangle #b5bd68 CompletarGestionController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> CompletarGestionView: completarGestion()
CompletarGestionView --> CompletarGestionController: coordinarCasoUso()
CompletarGestionController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
CompletarGestionView --> EstadoDestino: presentaResultado()

@enduml
