@startuml iniciarSesion-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "iniciarSesion()" {
    rectangle #629EF9 IniciarSesionView
    rectangle #b5bd68 IniciarSesionController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> IniciarSesionView: iniciarSesion()
IniciarSesionView --> IniciarSesionController: coordinarCasoUso()
IniciarSesionController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
IniciarSesionView --> EstadoDestino: presentaResultado()

@enduml
