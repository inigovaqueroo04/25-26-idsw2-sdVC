@startuml editarTarea-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "editarTarea()" {
    rectangle #629EF9 EditarTareaView
    rectangle #b5bd68 EditarTareaController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> EditarTareaView: editarTarea()
EditarTareaView --> EditarTareaController: coordinarCasoUso()
EditarTareaController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
EditarTareaView --> EstadoDestino: presentaResultado()

@enduml
