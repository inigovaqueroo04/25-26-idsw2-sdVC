@startuml abrirPlanificacion-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "abrirPlanificacion()" {
    rectangle #629EF9 AbrirPlanificacionView
    rectangle #b5bd68 AbrirPlanificacionController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> AbrirPlanificacionView: abrirPlanificacion()
AbrirPlanificacionView --> AbrirPlanificacionController: coordinarCasoUso()
AbrirPlanificacionController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
AbrirPlanificacionView --> EstadoDestino: presentaResultado()

@enduml
