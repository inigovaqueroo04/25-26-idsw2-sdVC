@startuml invitarUsuario-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "invitarUsuario()" {
    rectangle #629EF9 InvitarUsuarioView
    rectangle #b5bd68 InvitarUsuarioController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> InvitarUsuarioView: invitarUsuario()
InvitarUsuarioView --> InvitarUsuarioController: coordinarCasoUso()
InvitarUsuarioController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
InvitarUsuarioView --> EstadoDestino: presentaResultado()

@enduml
