@startuml eliminarGrupo-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "eliminarGrupo()" {
    rectangle #629EF9 EliminarGrupoView
    rectangle #b5bd68 EliminarGrupoController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> EliminarGrupoView: eliminarGrupo()
EliminarGrupoView --> EliminarGrupoController: coordinarCasoUso()
EliminarGrupoController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
EliminarGrupoView --> EstadoDestino: presentaResultado()

@enduml
