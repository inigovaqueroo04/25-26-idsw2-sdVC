@startuml eliminarMiembro-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "eliminarMiembro()" {
    rectangle #629EF9 EliminarMiembroView
    rectangle #b5bd68 EliminarMiembroController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> EliminarMiembroView: eliminarMiembro()
EliminarMiembroView --> EliminarMiembroController: coordinarCasoUso()
EliminarMiembroController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
EliminarMiembroView --> EstadoDestino: presentaResultado()

@enduml
