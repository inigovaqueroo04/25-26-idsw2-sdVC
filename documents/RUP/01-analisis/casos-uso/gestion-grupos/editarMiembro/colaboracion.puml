@startuml editarMiembro-analisis
skinparam linetype polyline

rectangle #CDEBA5 ":Estado origen SdR" as EstadoOrigen
rectangle #CDEBA5 ":Estado destino SdR" as EstadoDestino

package "editarMiembro()" {
    rectangle #629EF9 EditarMiembroView
    rectangle #b5bd68 EditarMiembroController
    rectangle #F2AC4E RepositorioDominio
    rectangle #F2AC4E EntidadDominio
}

EstadoOrigen --> EditarMiembroView: editarMiembro()
EditarMiembroView --> EditarMiembroController: coordinarCasoUso()
EditarMiembroController --> RepositorioDominio: consultarOModificarDominio()
RepositorioDominio -- EntidadDominio
EditarMiembroView --> EstadoDestino: presentaResultado()

@enduml
