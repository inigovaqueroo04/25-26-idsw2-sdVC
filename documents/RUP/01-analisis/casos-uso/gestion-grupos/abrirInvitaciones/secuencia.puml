@startuml abrirInvitaciones-analisis-secuencia
actor "Actor SdR" as Actor
boundary "AbrirInvitacionesView" as Vista
control "AbrirInvitacionesController" as Controlador
entity "RepositorioDominio" as Repositorio
entity "EntidadDominio" as Entidad

title Analisis de colaboracion: abrirInvitaciones()

Actor -> Vista : 1: solicita abrirInvitaciones()
Vista -> Controlador : 2: coordinarCasoUso()
Controlador -> Repositorio : 3: consultarOModificarDominio()
Repositorio -> Entidad : 4: usa entidad de dominio
Entidad --> Repositorio : 5: resultado
Repositorio --> Controlador : 6: resultado
Controlador --> Vista : 7: respuesta
Vista --> Actor : 8: presenta resultado

@enduml
